# ==============================================================================
# PyroWatch Fire Alert System — Environment Variables Configuration
# ==============================================================================
# Copy this file to `.env` in the same directory and update with your credentials:
# cp .env.example .env

# --- Hardware Serial Port ---
# On Windows: COM1, COM3, COM4, etc. (Check Device Manager -> Ports)
# On Linux / macOS: /dev/ttyUSB0, /dev/ttyACM0, /dev/cu.usbserial-xxx
SERIAL_PORT=COM3

# --- Twilio SMS Alert Gateway Credentials ---
# Sign up at https://www.twilio.com to obtain Account SID, Auth Token & Virtual Phone Number
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBER=+919876543210

# --- SMS Debounce & Rate Limiting ---
# Minimum time in seconds between repeat SMS alerts during continuous FIRE state
SMS_DEBOUNCE_SECONDS=120

# --- Web Server Configuration ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# --- SQLite Database ---
DATABASE_PATH=fire_alerts.db

# --- Mock Replay Settings ---
MOCK_REPLAY_FILE=mock_data.txt
MOCK_LINE_DELAY_SECONDS=1.0
