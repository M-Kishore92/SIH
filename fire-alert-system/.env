# ==============================================================================
# PyroWatch Fire Alert System — Your Credentials
# ==============================================================================

# --- Hardware Serial Port ---
SERIAL_PORT=COM3

# --- Twilio SMS Gateway ---
TWILIO_ACCOUNT_SID=AC8d8c8f1613b7c407753a824be16e2446

# Auth Token (leave blank if using API Key below)
TWILIO_AUTH_TOKEN=e2ec9d0abab0fb7b0defd87ab7b126c9

# API Key Authentication (alternative to Auth Token)
TWILIO_API_KEY_SID=SK33d89c9d04340e77719f68a171f95d17
TWILIO_API_KEY_SECRET=s0wm3W6xeEWEbKEBOHRaqqkCr4qlXX70

# Your Twilio virtual phone number (the "FROM" number)
# ⚠️ YOU STILL NEED THIS — go to Twilio Console → Phone Numbers → Buy a number
TWILIO_FROM_NUMBER=+17372508034

# Alert Channel: whatsapp, sms, or both
ALERT_CHANNEL=whatsapp
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Default recipient (your verified mobile number)
TWILIO_TO_NUMBER=+919500003045

# --- SMS Debounce & Frequency Limit ---
SMS_DEBOUNCE_SECONDS=120
# Send SMS only once per session to save Twilio credits on trial/free tier
SMS_SEND_ONCE=true
# Set to false so alerts only trigger when you press the top-right button
AUTO_DISPATCH_ENABLED=false

# --- Mock Mode Cycling ---
# Set to false if you want mock replay to stop after one pass instead of looping
MOCK_LOOP_FOREVER=true

# --- Web Server ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# --- Database ---
DATABASE_PATH=fire_alerts.db

# --- Mock Mode ---
MOCK_REPLAY_FILE=mock_data.txt
MOCK_LINE_DELAY_SECONDS=1.0
